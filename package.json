{
  "name": "livebid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:ui": "vite",
    "server:seed": "npm --prefix server run db:seed",
    "server:reset": "npm --prefix server run db:reset",
    "seo:generate": "node scripts/generate-seo.mjs",
    "seo:prerender": "node scripts/prerender-seo.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:i18n": "node scripts/verify-i18n-seo.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:e2e:browsers": "playwright test --project=chromium --project=firefox e2e/l2-gates.spec.ts e2e/l4-security.spec.ts e2e/l2-public.spec.ts",
    "test:e2e:webkit": "playwright test --project=webkit e2e/l2-gates.spec.ts e2e/l4-security.spec.ts",
    "verify:all": "node scripts/verify-all.mjs && playwright test --project=chromium",
    "verify:depth": "node scripts/verify-security-depth.mjs",
    "staging:check": "node scripts/staging-spa-check.mjs",
    "staging:up": "docker compose -f docker-compose.staging.yml up -d --build",
    "staging:down": "docker compose -f docker-compose.staging.yml down",
    "build": "npm run seo:generate && tsc -b && vite build && npm run seo:prerender",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
