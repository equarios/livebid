generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  accountId    String   @id
  passwordHash String
  company      String
  email        String
  firstName    String   @default("")
  lastName     String   @default("")
  address      String?
  phone        String?
  buyerNumber  String?
  role         String   @default("member")
  /// active | disabled | pending (legacy blocked login)
  status       String   @default("active")
  emailVerified Boolean @default(false)
  /// none | submitted | needs_docs | under_review | approved | rejected
  wholesaleStatus String @default("none")
  /// JSON: which events also send email (in-app notices always created)
  emailPrefsJson String @default("{\"win\":true,\"offer\":true,\"cart\":true,\"invoice\":true,\"payment\":true,\"shipping\":true,\"auth\":true,\"outbid\":false,\"closing\":false,\"fill\":false}")
  /// JSON: saved Device/Condition watch filters for offline match emails
  watchFiltersJson String @default("[]")
  /// Default fulfillment: pickup | delivery | buyer_courier
  preferredFulfillmentMode String?
  /// FedEx / UPS / DHL / Other — for buyer_courier default
  courierCarrier String?
  /// Buyer's own logistics account number
  courierAccount String?
  createdAt    DateTime @default(now())
  sessions     Session[]
  bids         Bid[]
  cartItems    CartItem[]
  cartOrders   CartOrder[]
  offers       MarketOffer[]
  invoices     Invoice[]
  watchlist    WatchItem[]
  notices      Notice[]
  passwordResets PasswordReset[]
  emailVerifies EmailVerify[]
  imeiPacks    ImeiPack[]
  storeOrders  StoreOrder[]
  wholesaleApp WholesaleApplication?
  documents    AccountDocument[]
  communityListings CommunityListing[]
  communityInterests CommunityInterest[]
}

/// Member Market — verified users post goods; staff moderate / feature.
model CommunityListing {
  id           String   @id @default(cuid())
  accountId    String
  title        String
  description  String   @default("")
  category     String   @default("Phones")
  manufacturer String   @default("")
  model        String   @default("")
  capacity     String   @default("")
  grade        String   @default("")
  color        String   @default("")
  qty          Int      @default(1)
  /// null = make offer / ask
  price        Float?
  currency     String   @default("USD")
  imageUrl     String?
  /// draft | pending | live | paused | rejected | closed
  status       String   @default("pending")
  featured     Boolean  @default(false)
  staffNote    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  publishedAt  DateTime?
  account      Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  interests    CommunityInterest[]

  @@index([status, featured])
  @@index([accountId])
  @@index([category])
}

model CommunityInterest {
  id        String   @id @default(cuid())
  listingId String
  accountId String
  message   String
  qtyWanted Int?
  /// open | contacted | closed
  status    String   @default("open")
  createdAt DateTime @default(now())
  listing   CommunityListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([listingId])
  @@index([accountId])
}

model EmailVerify {
  id        String   @id @default(cuid())
  accountId String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
}

/// Multi-step wholesale buyer application (Jotform-style welcome pack).
model WholesaleApplication {
  id           String   @id @default(cuid())
  accountId    String   @unique
  /// draft | submitted | needs_docs | under_review | approved | rejected
  status       String   @default("draft")
  /// JSON blob for wizard sections
  payloadJson  String   @default("{}")
  staffNote    String   @default("")
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  account      Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
}

model AccountDocument {
  id          String   @id @default(cuid())
  accountId   String
  /// client_upload | staff_send
  direction   String   @default("client_upload")
  /// application | tax | resale | id | other | staff_form
  category    String   @default("other")
  title       String
  fileName    String
  mimeType    String   @default("application/octet-stream")
  /// small demo files stored as base64
  dataBase64  String
  note        String   @default("")
  createdBy   String
  createdAt   DateTime @default(now())
  account     Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
}

/// Retail consumer catalog (separate from wholesale auction / marketplace lots).
model StoreProduct {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  price       Float
  compareAt   Float?
  stock       Int      @default(0)
  category    String   @default("Phones")
  /// Maker / brand shown on store cards (e.g. Apple, Samsung).
  brand       String   @default("")
  /// Same structured specs as auction lots (shown on cards).
  modelNumber String   @default("")
  capacity    String   @default("")
  color       String   @default("")
  grade       String   @default("")
  /// 0 = unknown / hide on card.
  battery     Int      @default(0)
  origin      String   @default("INT")
  simLocked   Boolean  @default(false)
  activationLocked Boolean @default(false)
  /// Cover / legacy single image.
  imageUrl    String?
  /// Ordered gallery URLs (JSON string[]). First is cover; synced to imageUrl.
  images      Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lines       StoreOrderLine[]

  @@index([active, category])
}

model StoreOrder {
  id            String   @id
  accountId     String?
  email         String
  name          String
  phone         String?
  address       String   @default("")
  /// pickup | delivery | buyer_courier
  fulfillmentMode String @default("delivery")
  /// FedEx / UPS / DHL / Other — used when fulfillmentMode = buyer_courier
  courierCarrier  String?
  /// Buyer's own logistics account number (optional until collect)
  courierAccount  String?
  /// Staff marked goods ready for warehouse pickup / buyer courier collect
  readyForCollect Boolean @default(false)
  /// When delivery payer is admin_decide: false = fee TBD until staff quotes
  shippingFeeQuoted Boolean @default(true)
  /// Buyer-requested pickup day (YYYY-MM-DD)
  pickupDate    String?
  /// Slot window e.g. 10:00-12:00
  pickupSlot    String?
  status        String   @default("pending_payment")
  paymentMethod String
  paymentRef    String?
  subtotal      Float
  /// Promo discount applied to subtotal (USD).
  discount      Float    @default(0)
  /// Normalised promo code used at checkout.
  promoCode     String?
  /// Tax charged on top (exclusive mode). 0 when tax is none or inclusive.
  tax           Float    @default(0)
  shippingFee   Float    @default(0)
  total         Float
  /// Shopper display currency at checkout (prices above stay USD).
  displayCurrency String @default("USD")
  /// Units of displayCurrency per 1 USD at checkout time.
  displayRate   Float    @default(1)
  /// total * displayRate, stamped so later rate changes do not rewrite history.
  displayTotal  Float?
  note          String?
  createdAt     DateTime @default(now())
  paidAt        DateTime?
  shippedAt     DateTime?
  /// Outbound tracking number when we ship (delivery). Pickup stays collect-only.
  trackingNo    String?
  /// Provisional trade-in credit deducted at checkout (USD). Final settles on StoreTradeIn.
  tradeInCredit Float @default(0)
  account       Account? @relation(fields: [accountId], references: [accountId], onDelete: SetNull)
  lines         StoreOrderLine[]
  tradeIn       StoreTradeIn?

  @@index([accountId])
  @@index([email])
  @@index([status])
  @@index([fulfillmentMode])
}

/// Consumer trade-in attached to a store order — QC before final credit.
model StoreTradeIn {
  id                 String   @id
  orderId            String   @unique
  email              String
  name               String
  label              String
  deviceId           String
  grade              String
  battery            Int      @default(0)
  simLocked          Boolean  @default(false)
  activationLocked   Boolean  @default(false)
  estimateLow        Float
  estimateHigh       Float
  provisionalCredit  Float
  finalCredit        Float?
  /// Ordered photo URLs: front, back, left, right, then optional extras.
  images             Json     @default("[]")
  /// Optional short condition video URL.
  videoUrl           String?
  /// Consumer-entered IMEI (digits), used for QC / identity.
  imei               String?
  /// pending_receive | received | accepted | adjusted | rejected
  status             String   @default("pending_receive")
  staffNote          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  order              StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([email])
  @@index([imei])
}

/// Free TAC → brand/model for consumer trade-in identity (first 8 IMEI digits).
model StoreImeiTac {
  tac       String   @id
  brand     String
  model     String
  /// Marketing / raw label from TAC source.
  name      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brand, model])
}

/// Staff-editable trade-in estimate matrix (Grade A unlocked base USD).
model StoreTradeInDevice {
  id          String   @id
  brand       String
  model       String
  /// Hardware / marketing model number (e.g. A3090, SM-S921B).
  modelNumber String   @default("")
  capacity    String
  baseUsd     Float
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
  @@index([brand])
}

/// FX table: how many units of `code` equal 1 USD. USD row is always perUsd=1.
model FxRate {
  code      String   @id
  perUsd    Float
  source    String   @default("open.er-api.com")
  fetchedAt DateTime @default(now())
}

model StoreOrderLine {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  title     String
  unitPrice Float
  qty       Int
  order     StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   StoreProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ImeiPack {
  id        String   @id @default(cuid())
  title     String
  accountId String?
  invoiceId String?
  note      String?
  createdBy String
  createdAt DateTime @default(now())
  account   Account? @relation(fields: [accountId], references: [accountId], onDelete: SetNull)
  devices   ImeiDevice[]

  @@index([accountId])
  @@index([invoiceId])
}

model ImeiDevice {
  id         String  @id @default(cuid())
  packId     String
  imei       String
  unlockCode String
  model      String?
  box        String?
  pack       ImeiPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, imei])
  @@index([imei])
}

model PasswordReset {
  id        String   @id @default(cuid())
  accountId String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  accountId String
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

model Lot {
  id               String   @id
  channel          String
  auctionType      String?
  manufacturer     String
  model            String
  modelNumber      String
  capacity         String
  color            String
  grade            String
  battery          Int
  qty              Int
  moq              Int?
  startPrice       Float
  currentPrice     Float
  buyNowPrice      Float?
  bidCount         Int      @default(0)
  endsAt           BigInt
  /// When set and after endsAt: Extra sealed overtime (prior bidders only). Settlement uses this clock.
  extraSealedEndsAt BigInt?
  description      String
  accent           String   @default("#2a6f7c")
  operator         String?
  simLocked        Boolean?
  activationLocked Boolean?
  origin           String?
  bids             Bid[]
  cartItems        CartItem[]
  offers           MarketOffer[]

  @@index([channel, endsAt])
  @@index([auctionType])
  @@index([endsAt])
}

model InventorySku {
  id               String  @id
  manufacturer     String
  model            String
  modelNumber      String
  capacity         String
  color            String
  grade            String
  battery          Int
  origin           String  @default("")
  operator         String?
  simLocked        Boolean?
  activationLocked Boolean?
  description      String
  defaultMoq       Int?
  lastPrice        Float?
  /** Warehouse stock (pcs on hand). */
  onHand           Int     @default(0)
  /** What the company paid per piece. Super only — never mapped to staff or buyers. */
  unitCost         Float?
}

model StockMove {
  id        String   @id @default(cuid())
  skuId     String
  productId String
  qty       Int
  createdAt DateTime @default(now())

  @@index([skuId])
}

/// Pieces taken out of the warehouse when a lot is launched. One row per lot.
model StockHold {
  lotId      String    @id
  skuId      String
  qty        Int
  /// return = leftover added back once. leave = admin kept it out.
  decision   String?
  decidedAt  DateTime?
  /** Pieces left out of the warehouse when decision = leave. */
  writeoffQty Int?
  createdAt  DateTime  @default(now())

  @@index([skuId])
}

model Bid {
  id        String   @id @default(cuid())
  lotId     String
  accountId String
  amount    Float
  qty       Int
  at        BigInt
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([lotId])
  @@index([accountId])
  @@index([lotId, at])
  @@index([at])
}

model CartItem {
  id        String  @id @default(cuid())
  accountId String
  lotId     String
  qty       Int
  account   Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  lot       Lot     @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([accountId, lotId])
}

model CartOrder {
  id         String   @id
  accountId  String
  status     String
  createdAt  BigInt
  reviewedAt BigInt?
  reviewedBy String?
  linesJson  String
  account    Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, status])
}

model MarketOffer {
  id          String  @id
  lotId       String
  accountId   String
  qty         Int
  unitPrice   Float
  listedPrice Float
  status      String
  createdAt   BigInt
  reviewedAt  BigInt?
  reviewedBy  String?
  lot         Lot     @relation(fields: [lotId], references: [id], onDelete: Cascade)
  account     Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, status])
}

model Invoice {
  id        String  @id
  lotId     String
  channel   String
  amount    Float
  qty       Int
  unitPrice Float
  status    String
  createdAt BigInt
  /// Stamped the first time status becomes paid. Older paid rows fall back to createdAt.
  paidAt    BigInt?
  accountId String?
  dataJson  String
  account   Account? @relation(fields: [accountId], references: [accountId], onDelete: SetNull)

  @@index([accountId])
  @@index([status])
}

model WatchItem {
  id        String  @id @default(cuid())
  accountId String
  lotId     String
  account   Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@unique([accountId, lotId])
}

model Notice {
  id        String  @id
  accountId String
  kind      String
  title     String
  body      String
  href      String
  at        BigInt
  read      Boolean @default(false)
  account   Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, at])
}

model AppMeta {
  key   String @id
  value String
}

/// Marketing / CRM contacts (separate from login accounts). Synced to Brevo lists.
model MarketingClient {
  id            String   @id @default(cuid())
  email         String   @unique
  firstName     String   @default("")
  lastName      String   @default("")
  company       String   @default("")
  phone         String   @default("")
  /// comma-separated tags
  tags          String   @default("")
  /// subscribed | unsubscribed | bounced | complained
  status        String   @default("subscribed")
  consentAt     DateTime?
  source        String   @default("manual")
  accountId     String?
  brevoId       String?
  lastSyncedAt  DateTime?
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([tags])
}

/// Outbound marketing campaigns sent via Brevo.
model EmailCampaign {
  id              String   @id @default(cuid())
  name            String
  subject         String
  previewText     String   @default("")
  htmlBody        String
  textBody        String   @default("")
  /// all_subscribed | tag:<name> | status:subscribed
  audience        String   @default("all_subscribed")
  /// draft | syncing | ready | sending | sent | failed | simulated
  status          String   @default("draft")
  brevoCampaignId String?
  brevoListId     String?
  errorMessage    String   @default("")
  /// JSON snapshot of Brevo stats
  statsJson       String   @default("{}")
  recipientCount  Int      @default(0)
  createdBy       String
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}
