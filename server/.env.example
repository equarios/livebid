PORT=8787

# --- Database ---
# Scale stack (default): Postgres via `docker compose up -d`
DATABASE_URL="postgresql://equarios:equarios@localhost:5432/equarios?schema=public"

# SQLite fallback (local only): set prisma provider back to "sqlite", then:
# DATABASE_URL="file:./dev.db"

# --- Cache / rate limits ---
# Optional. When unset, in-process memory is used.
REDIS_URL="redis://localhost:6379"

# --- Care worker (settlement + closing-soon) ---
# Default: API runs care jobs inline (fine for local demo).
# Split (recommended for production):
#   CARE_INLINE=0
#   npm run start          # API only
#   npm run worker:start   # settlement worker
# CARE_INLINE=0
# CARE_INTERVAL_MS=30000

# --- Object storage / CDN ---
# S3-compatible (AWS S3, Cloudflare R2, or Silo from docker compose).
# When unset, uses ./uploads
S3_BUCKET=equarios
S3_REGION=us-east-1
S3_ACCESS_KEY=equarios
S3_SECRET_KEY=equariossecret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=1
S3_PUBLIC_BASE_URL=http://localhost:9000/equarios
# CDN_BASE_URL=https://cdn.example.com

# Mail (optional). When unset, verification / reset codes are returned in API for local/dev.
# RESEND_API_KEY=
# MAIL_FROM="Equarios <noreply@yourdomain.com>"
MAIL_EXPOSE_CODES=1

# Trade-in ship-to address shown in post-checkout email (multiline OK with \n).
# TRADE_IN_SHIP_TO=Equarios Trade-in\n123 Warehouse Rd\nCity, Country

# Brevo marketing (optional — set when publishing)
# BREVO_API_KEY=

# Trade-in TAC lookup on miss (optional). Free ~100/mo — request key at hicelltek.com
# HICELLTEK_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=
# BREVO_LIST_ID=
# BREVO_FOLDER_ID=
# BREVO_WEBHOOK_SECRET=
