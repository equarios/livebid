    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "hono": "^4.9.8",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2"
  }
}
